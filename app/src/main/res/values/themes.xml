<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Settings screen: always the light pink palette, no action bar (the layout draws its own header). -->
    <style name="AppTheme" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/screen_bg</item>
        <item name="android:statusBarColor">@color/screen_bg</item>
        <item name="android:navigationBarColor">@color/screen_bg</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:colorPrimary">@color/petal_rouge</item>
        <item name="android:colorPrimaryDark">@color/screen_bg</item>
        <item name="android:colorAccent">@color/petal_rouge</item>
        <item name="android:colorControlActivated">@color/petal_rouge</item>
        <item name="android:colorControlNormal">@color/ink</item>
        <item name="android:textColorPrimary">@color/screen_text</item>
        <item name="android:textColorSecondary">@color/screen_text_secondary</item>
        <item name="android:textColorHint">@color/screen_text_secondary</item>
        <item name="android:alertDialogTheme">@style/PlayfulDialog</item>
    </style>

    <!-- Fully see-through, no animation: the home screen stays visible during a tap-refresh -->
    <style name="InvisibleRefresh" parent="android:Theme.Translucent.NoTitleBar">
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>

    <style name="PlayfulDialog" parent="android:Theme.Material.Light.Dialog.Alert">
        <item name="android:windowBackground">@drawable/dialog_bg</item>
        <item name="android:colorAccent">@color/petal_rouge</item>
        <item name="android:colorControlActivated">@color/petal_rouge</item>
        <item name="android:colorControlNormal">@color/petal_rouge</item>
        <item name="android:textColorPrimary">@color/screen_text</item>
        <item name="android:textColorSecondary">@color/screen_text_secondary</item>
    </style>

    <!-- Chunky pill buttons with an offset shadow -->
    <style name="PillButton" parent="android:Widget.Material.Button.Borderless">
        <item name="android:background">@drawable/btn_secondary</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:fontFamily">sans-serif-black</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/screen_text</item>
        <item name="android:textSize">15sp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">21dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">11dp</item>
    </style>

    <style name="PillButton.Primary">
        <item name="android:background">@drawable/btn_primary</item>
    </style>

    <style name="PillButton.Text">
        <item name="android:background">@null</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
    </style>
</resources>
