<?xml version="1.0" encoding="utf-8"?>
<!-- Scroll-wheel picker for when a tile lights up. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="34dp"
    android:paddingTop="30dp"
    android:paddingEnd="38dp"
    android:paddingBottom="32dp">

    <TextView
        android:id="@+id/highlight_line"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/sticker_bg"
        android:fontFamily="sans-serif-black"
        android:paddingStart="10dp"
        android:paddingTop="3dp"
        android:paddingEnd="13dp"
        android:paddingBottom="6dp"
        android:textColor="@color/screen_text"
        android:textSize="12sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:fontFamily="sans-serif-black"
        android:gravity="center"
        android:text="@string/highlight_title"
        android:textColor="@color/screen_text"
        android:textSize="18sp" />

    <NumberPicker
        android:id="@+id/picker"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:descendantFocusability="blocksDescendants" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/cancel"
            style="@style/PillButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@android:string/cancel" />

        <Button
            android:id="@+id/ok"
            style="@style/PillButton.Primary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:text="@string/set" />
    </LinearLayout>
</LinearLayout>
