<?xml version="1.0" encoding="utf-8"?>
<!-- One tile in the widget's order: number, line + stop, highlight chip, move buttons. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:descendantFocusability="blocksDescendants">

    <LinearLayout
        android:id="@+id/card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/card_bg_1"
        android:gravity="center_vertical"
        android:minHeight="62dp"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingTop="6dp"
        android:paddingEnd="9dp"
        android:paddingBottom="9dp">

        <TextView
            android:id="@+id/position"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:background="@drawable/badge_1"
            android:fontFamily="sans-serif-black"
            android:gravity="center"
            android:textColor="@color/screen_text"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/line"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:textColor="@color/screen_text"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/stop"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/screen_text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <Button
            android:id="@+id/highlight"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/badge_1"
            android:contentDescription="@string/highlight_title"
            android:focusable="false"
            android:fontFamily="sans-serif-black"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:singleLine="true"
            android:stateListAnimator="@null"
            android:textAllCaps="false"
            android:textColor="@color/screen_text"
            android:textSize="12sp" />

        <Button
            android:id="@+id/up"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/round_btn"
            android:contentDescription="@string/move_up"
            android:focusable="false"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:stateListAnimator="@null"
            android:text="▲"
            android:textColor="@color/screen_text"
            android:textSize="11sp" />

        <Button
            android:id="@+id/down"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="5dp"
            android:background="@drawable/round_btn"
            android:contentDescription="@string/move_down"
            android:focusable="false"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:stateListAnimator="@null"
            android:text="▼"
            android:textColor="@color/screen_text"
            android:textSize="11sp" />
    </LinearLayout>
</FrameLayout>
