<?xml version="1.0" encoding="utf-8"?>
<!-- Playful "sticker" card: solid offset shadow plus a chunky outline. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:left="5dp" android:top="5dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/widget_shadow" />
            <corners android:radius="@dimen/widget_radius" />
        </shape>
    </item>
    <item android:bottom="5dp" android:right="5dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/widget_face" />
            <stroke android:width="2.5dp" android:color="@color/outline" />
            <corners android:radius="@dimen/widget_radius" />
        </shape>
    </item>
</layer-list>
